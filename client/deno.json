{
  "tasks": {
    "build": "deno run -A npm:typescript@^7.0.2/tsc -p tsconfig.json",
    "serve": "deno run -A jsr:@std/http/file-server -p 8080 .",
    "lint": "deno lint src/",
    "fmt": "deno fmt src/"
  },
  "lint": {
    "include": ["src/"],
    "rules": {
      "exclude": ["no-window", "no-window-prefix", "no-sloppy-imports"]
    }
  },
  "fmt": {
    "include": ["src/"],
    "lineWidth": 100,
    "singleQuote": true
  }
}
